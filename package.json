{
  "name": "devfast-java-mcp",
  "version": "1.0.0",
  "description": "Standalone MCP Server for GitLab Template Context",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --minify",
    "start": "node dist/index.js",
    "dev": "tsup src/index.ts --format esm --watch --onSuccess \"node dist/index.js\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "axios": "^1.6.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "tsup": "^8.0.0",
    "typescript": "^5.2.2"
  }
}
